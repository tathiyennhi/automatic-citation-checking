  "bib_entries": {
    "62599969": {
      "title": "Simulating speech systems",
      "abstract": "Abstract This paper reviews the \u201cWizard of Oz\u201d technique for simulating future interactive technology and develops a partial taxonomy of such simulations. The issues of particular relevance to Wizard of Oz simulations of speech input/output computer systems are discussed and some experimental variables and confounding factors are reviewed. A general Wizard of Oz methodology is suggested."
    }
  }
}